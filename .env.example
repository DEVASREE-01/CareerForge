# ==============================================================================
# CAREERFORGE PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your deployment secrets.
# NEVER commit your actual .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/careerforge

# ------------------------------------------------------------------------------
# 2. SERVER & FRONTEND/BACKEND URLS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. JWT & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-jwt-secret-min-32-chars

# ------------------------------------------------------------------------------
# 4. OTP SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
OTP_PEPPER=replace-with-a-secure-random-otp-pepper
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_LOGIN_WINDOW_MIN=5
AUTH_RATE_LIMIT_REGISTER_MAX=8
AUTH_RATE_LIMIT_REGISTER_WINDOW_MIN=15
AUTH_RATE_LIMIT_OTP_REQ_MAX=4
AUTH_RATE_LIMIT_OTP_REQ_WINDOW_MIN=10
AUTH_RATE_LIMIT_OTP_VER_MAX=10
AUTH_RATE_LIMIT_OTP_VER_WINDOW_MIN=5
AUTH_RATE_LIMIT_RESET_MAX=3
AUTH_RATE_LIMIT_RESET_WINDOW_MIN=15

# ------------------------------------------------------------------------------
# 5. EMAIL PROVIDER CONFIGURATION
# In local development without credentials, CareerForge prints formatted emails
# to the server console. In production, an active provider is strictly enforced.
# NOTE: The sender address (EMAIL_FROM) must be verified in your provider account.
# ------------------------------------------------------------------------------
EMAIL_FROM=CareerForge <noreply@careerforge.dev>
# Optional explicit selector: 'resend' | 'sendgrid' | 'smtp' | 'dev'
EMAIL_PROVIDER=resend

# Option A: Resend (Primary Recommended Production Provider)
# Sign up at https://resend.com, verify domain, and create an API key
RESEND_API_KEY=

# Option B: SendGrid
# Sign up at https://sendgrid.com and generate an API key with Mail Send permissions
SENDGRID_API_KEY=

# Option C: Custom SMTP / Nodemailer (AWS SES, Brevo, Mailgun, custom SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 / OPENID CONNECT
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   - Direct Backend Callback:  http://localhost:5000/api/auth/google/callback
#   - Frontend Proxy Callback:  http://localhost:5173/api/auth/google/callback
#   - SPA Redirect Callback:    http://localhost:5173/auth?provider=google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ------------------------------------------------------------------------------
# 7. GITHUB OAUTH 2.0
# Create OAuth App at: https://github.com/settings/developers
# Authorization callback URL:
#   - Direct Backend Callback:  http://localhost:5000/api/auth/github/callback
#   - Frontend Proxy Callback:  http://localhost:5173/api/auth/github/callback
#   - SPA Redirect Callback:    http://localhost:5173/auth?provider=github
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# ------------------------------------------------------------------------------
# 8. EXTERNAL AI & CONTENT APIS (Feature-specific)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
YOUTUBE_API_KEY=
GITHUB_TOKEN=
